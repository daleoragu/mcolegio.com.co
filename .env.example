# =============================================================================
# .env de EJEMPLO para trabajar en su computador.
#
# Copie este archivo como «.env» (en la misma carpeta que manage.py) y llénelo.
# El .env de verdad NUNCA se sube a GitHub (está en .gitignore).
#
# REGLA DE ORO: el .env de su computador NO es el de producción.
#   * En producción las variables se ponen en DigitalOcean (App > Settings >
#     Environment Variables), no en un archivo.
#   * Si en local copia el DATABASE_URL de producción, todo lo que haga en su
#     computador (incluido «migrate») le pasa a los colegios de verdad.
# =============================================================================

# --- Modo desarrollo ---------------------------------------------------------
# True en su computador: lee los estilos de static/ directamente (sin
# collectstatic) y muestra el error completo cuando algo falla.
# En producción va False.
DJANGO_DEBUG=True

# Cualquier texto largo y aleatorio. El de producción es otro y es secreto.
DJANGO_SECRET_KEY=cambie-esto-por-algo-largo-y-aleatorio-solo-para-local

# --- Base de datos -----------------------------------------------------------
# Déjelo comentado para usar db.sqlite3 de su computador (lo normal en local).
# Solo descoméntelo para apuntar a una base de PRUEBA, nunca a la de producción.
# DATABASE_URL=postgres://usuario:clave@host:25060/base_de_prueba?sslmode=require

# --- Archivos (escudos, documentos, fotos) -----------------------------------
# Comentado = se guardan en la carpeta media/ de su computador.
# Si lo activa, local y producción comparten el mismo bucket de Spaces: lo que
# suba o borre en local se sube o se borra para los colegios.
# DO_SPACES_BUCKET_NAME=
# DO_SPACES_REGION=nyc3
# DO_SPACES_ACCESS_KEY=
# DO_SPACES_SECRET_KEY=

# --- Errores -----------------------------------------------------------------
# Opcional. Con esto Sentry le avisa por correo de cada error (sentry.io, plan
# gratis). En local normalmente se deja vacío.
# SENTRY_DSN=
# Cuánto detalle sale en la terminal: DEBUG, INFO, WARNING.
MCOLEGIO_LOG_LEVEL=INFO

# --- Salón Digital -----------------------------------------------------------
# Dominio con el que se arman los enlaces públicos de Salón Digital.
# SALON_DOMINIO_PUBLICO=https://mcolegio.com.co
